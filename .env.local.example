# Copy to .env.local for local development. .env* is gitignored.
#
# Both are NEXT_PUBLIC_, so they are compiled into the JavaScript the browser
# downloads. That is fine for the anon key - it is a public identifier, and
# row-level security is what actually protects the data.
#
# Never put the service_role key in this file or any other file in this repo.
# It bypasses RLS, and a static build ships everything to the browser.

NEXT_PUBLIC_SUPABASE_URL=https://mkcuiglmsmxcchywruay.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
